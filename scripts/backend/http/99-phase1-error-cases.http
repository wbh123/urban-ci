### 404-5 已删除资源查询
### 注意：需要先执行 02-community.http 的删除流程，然后在此查询
### GET {{baseUrl}}/api/v1/communities/{{deletedCommunityId}}
### Authorization: Bearer {{accessToken}}

### --- 409 冲突 ---

### 409-1 创建重复编码小区
POST {{baseUrl}}/api/v1/communities
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "communityCode": "DUP-COM-001",
  "communityName": "重复编码小区1"
}

> {%
  client.global.set("dupComId1", response.body.data ? response.body.data.id : null);
%}

### 再次创建相同编码
POST {{baseUrl}}/api/v1/communities
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "communityCode": "DUP-COM-001",
  "communityName": "重复编码小区2"
}

> {%
  client.test("重复编码创建小区返回 409", function () {
    client.assert(response.status === 409, "预期状态码为 409");
    client.assert(response.body.success === false);
    client.assert(response.body.error !== null);
  });
%}

### 409-2 创建楼栋编码冲突
POST {{baseUrl}}/api/v1/buildings
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "communityId": "{{dupComId1}}",
  "buildingCode": "DUP-BLD-001",
  "buildingName": "重复编码楼栋1"
}

> {%
  client.global.set("dupBldId1", response.body.data ? response.body.data.id : null);
%}

### 同一小区再次创建相同编码
POST {{baseUrl}}/api/v1/buildings
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "communityId": "{{dupComId1}}",
  "buildingCode": "DUP-BLD-001",
  "buildingName": "重复编码楼栋2"
}

> {%
  client.test("楼栋编码冲突返回 409", function () {
    client.assert(response.status === 409, "预期状态码为 409");
    client.assert(response.body.success === false);
  });
%}

### 409-3 删除有楼栋的小区
POST {{baseUrl}}/api/v1/buildings
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "communityId": "{{dupComId1}}",
  "buildingCode": "CONFLICT-BLD-001",
  "buildingName": "阻止删除的楼栋"
}

### 尝试删除有楼栋的小区
DELETE {{baseUrl}}/api/v1/communities/{{dupComId1}}
Authorization: Bearer {{accessToken}}

> {%
  client.test("删除有楼栋的小区返回 409", function () {
    client.assert(response.status === 409, "预期状态码为 409");
    client.assert(response.body.success === false);
  });
%}

### 清理：先删除楼栋再删除小区
DELETE {{baseUrl}}/api/v1/buildings/{{dupBldId1}}
Authorization: Bearer {{accessToken}}

DELETE {{baseUrl}}/api/v1/buildings/{{dupBldId2}}
Authorization: Bearer {{accessToken}}

DELETE {{baseUrl}}/api/v1/communities/{{dupComId1}}
Authorization: Bearer {{accessToken}}

> {%
  client.test("清理测试数据成功", function () {
    client.assert(response.status === 200);
  });
%}
