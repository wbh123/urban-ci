# UrbanSafe Priority 唯一运行配置模板
#
# 使用方式：
#   cp .env.example .env
#   修改 .env 中的密码、密钥和本机地址。
#
# 根目录 .env 是本地运行参数的唯一持久化来源：
# - Docker Compose 通过 --env-file .env 读取；
# - Spring Boot 的 application.yaml 自动导入项目根目录 .env；
# - FastAPI 兼容读取同一组 URBAN_SAFE_ 前缀变量；
# - .env 已被 .gitignore 排除，不得提交真实密码、密钥、令牌和模型凭据。

# ---------- 通用 ----------
URBAN_SAFE_TIMEZONE=Asia/Shanghai
URBAN_SAFE_SERVER_PORT=8888
URBAN_SAFE_AI_SERVICE_PORT=8001

# ---------- PostgreSQL ----------
URBAN_SAFE_POSTGRES_IMAGE=imresamu/postgis:17-3.6.1-bundle0-bookworm
URBAN_SAFE_DB_HOST=localhost
URBAN_SAFE_DB_PORT=5432
URBAN_SAFE_DB_NAME=urban_safe_priority
URBAN_SAFE_DB_USER=urban_safe_dev
URBAN_SAFE_DB_PASSWORD=请替换为数据库密码

# ---------- Java Web Token 与初始化管理员 ----------
URBAN_SAFE_AUTH_JWT_ISSUER=urban-safe-priority
URBAN_SAFE_AUTH_JWT_AUDIENCE=urban-safe-web
URBAN_SAFE_AUTH_JWT_SECRET=请替换为至少32字节的随机签名密钥
URBAN_SAFE_AUTH_ACCESS_TOKEN_TTL_SECONDS=7200
URBAN_SAFE_BOOTSTRAP_ADMIN_ENABLED=true
URBAN_SAFE_BOOTSTRAP_ADMIN_USERNAME=admin
URBAN_SAFE_BOOTSTRAP_ADMIN_PASSWORD=请替换为管理员密码
URBAN_SAFE_BOOTSTRAP_ADMIN_REAL_NAME=开发管理员

# ---------- 跨域 ----------
URBAN_SAFE_CORS_ALLOWED_ORIGINS=http://localhost:5173
URBAN_SAFE_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
URBAN_SAFE_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-UrbanSafe-Request-Id
URBAN_SAFE_CORS_ALLOW_CREDENTIALS=true

# ---------- 高德地图 ----------
URBAN_SAFE_MAP_ENABLED=true
URBAN_SAFE_MAP_PROVIDER=AMAP
URBAN_SAFE_MAP_DEFAULT_CENTER_LONGITUDE=113.13396
URBAN_SAFE_MAP_DEFAULT_CENTER_LATITUDE=27.82767
URBAN_SAFE_MAP_DEFAULT_ZOOM=12
URBAN_SAFE_AMAP_JS_API_KEY=
URBAN_SAFE_AMAP_SECURITY_JS_CODE=
URBAN_SAFE_AMAP_SERVICE_HOST=/_AMapService
URBAN_SAFE_AMAP_WEB_SERVICE_KEY=
URBAN_SAFE_AMAP_WEB_SERVICE_BASE_URL=https://restapi.amap.com
URBAN_SAFE_AMAP_CONNECT_TIMEOUT_MS=3000
URBAN_SAFE_AMAP_READ_TIMEOUT_MS=5000
URBAN_SAFE_AMAP_CACHE_TTL_SECONDS=86400
URBAN_SAFE_AMAP_LIVE_TEST_ENABLED=false
# 比赛演示默认开启候选边界；该能力仅提供候选预览，仍需人工采用、保存并确认后才进入正式地图。
URBAN_SAFE_AMAP_BOUNDARY_CANDIDATE_ENABLED=true

# ---------- MinIO 镜像 ----------
MINIO_SERVER_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_CLIENT_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z

# ---------- MinIO 服务与管理账号 ----------
URBAN_SAFE_MINIO_HOST=localhost
URBAN_SAFE_MINIO_API_PORT=9000
URBAN_SAFE_MINIO_CONSOLE_PORT=9001
URBAN_SAFE_MINIO_ROOT_USER=urban_safe_admin
URBAN_SAFE_MINIO_ROOT_PASSWORD=请替换为MinIO根账号密码

# ---------- MinIO 应用账号 ----------
URBAN_SAFE_MINIO_APP_USER=urban_safe_app
URBAN_SAFE_MINIO_APP_PASSWORD=请替换为MinIO应用账号密码
URBAN_SAFE_MINIO_POLICY_NAME=urban-safe-app-policy

# ---------- MinIO 私有存储桶 ----------
URBAN_SAFE_MINIO_ASSETS_BUCKET=urban-safe-assets
URBAN_SAFE_MINIO_REPORTS_BUCKET=urban-safe-reports
URBAN_SAFE_MINIO_MODELS_BUCKET=urban-safe-models

# ---------- Spring Boot 对象存储与上传 ----------
URBAN_SAFE_STORAGE_PROVIDER=MINIO
URBAN_SAFE_STORAGE_LOCAL_DIRECTORY=data/local-assets
URBAN_SAFE_STORAGE_MAX_IMAGE_SIZE_BYTES=10485760
URBAN_SAFE_STORAGE_MAX_REQUEST_SIZE_BYTES=12582912
URBAN_SAFE_STORAGE_PREVIEW_EXPIRY_SECONDS=900

# ---------- 人工智能推理服务（FastAPI） ----------
URBAN_SAFE_AI_SERVICE_BASE_URL=http://localhost:8001
URBAN_SAFE_AI_CONNECT_TIMEOUT_MS=3000
URBAN_SAFE_AI_READ_TIMEOUT_MS=15000
URBAN_SAFE_AI_PRECISION_READ_TIMEOUT_MS=90000
URBAN_SAFE_AI_ACCURACY_READ_TIMEOUT_MS=180000
URBAN_SAFE_AI_DEFAULT_MOCK_MODEL_ID=AI-DEFECT-MOCK-001
URBAN_SAFE_AI_DEFAULT_MODE=MOCK
URBAN_SAFE_AI_MOCK_MODEL_NAME=UrbanSafe Deterministic Mock Detector
URBAN_SAFE_AI_MOCK_MODEL_VERSION=0.1.0
URBAN_SAFE_AI_MAX_IMAGE_SIZE_BYTES=10485760
URBAN_SAFE_AI_LOW_QUALITY_MIN_SIDE=32

# ---------- 本地图片语义适用性门禁（CPU / ONNX） ----------
# 只判断“是否适合进入建筑表观病害分析”，不判断具体病害。
# 权重不存在、加载失败或置信不足时稳定返回 UNCERTAIN，并由后续视觉业务决定是否继续。
# 本地直接运行 FastAPI 时可把模型放到下列路径；Docker no-CUDA 会把 no-cuda-models 挂载到 /app/models。
URBAN_SAFE_AI_APPLICABILITY_ENABLED=true
URBAN_SAFE_AI_APPLICABILITY_MODEL_ID=LOCAL-IMAGE-APPLICABILITY-001
URBAN_SAFE_AI_APPLICABILITY_MODEL_VERSION=1.0.0
URBAN_SAFE_AI_APPLICABILITY_MODEL_PATH=data/ai-service/no-cuda-models/image-applicability/model.onnx
URBAN_SAFE_AI_APPLICABILITY_METADATA_PATH=data/ai-service/no-cuda-models/image-applicability/model.json
URBAN_SAFE_AI_APPLICABILITY_REJECT_THRESHOLD=0.90
URBAN_SAFE_AI_APPLICABILITY_APPLICABLE_THRESHOLD=0.60

# ---------- 第七阶段人工智能提供者路由 ----------
# 请求未指定提供者时按能力使用以下默认值；不做静默跨提供者降级。
URBAN_SAFE_AI_DEFAULT_VISION_PROVIDER=FAST_API
URBAN_SAFE_AI_DEFAULT_WORKFLOW_PROVIDER=DIFY
URBAN_SAFE_AI_DEFAULT_TEXT_PROVIDER=SPRING_AI

# ---------- 人工智能异步执行 ----------
# 图片上传只创建持久化任务；后台工作器通过 PostgreSQL 租约领取，不依赖消息队列。
URBAN_SAFE_AI_EXECUTION_ENABLED=true
URBAN_SAFE_AI_EXECUTION_POLL_DELAY_MS=1000
URBAN_SAFE_AI_EXECUTION_LEASE_SECONDS=360
URBAN_SAFE_AI_EXECUTION_RETRY_BASE_DELAY_SECONDS=15
URBAN_SAFE_AI_EXECUTION_BATCH_SIZE=2
URBAN_SAFE_AI_EXECUTION_WORKER_ID=urban-safe-worker

# ---------- Dify Workflow ----------
# Dify 只负责编排复核辅助、报告草稿等复杂工作流，不作为上传图片默认视觉识别入口。
# 密钥只保存在本机 .env 或部署密钥系统，不得提交到仓库。
URBAN_SAFE_DIFY_ENABLED=false
URBAN_SAFE_DIFY_BASE_URL=https://api.dify.ai/v1
URBAN_SAFE_DIFY_API_KEY=
URBAN_SAFE_DIFY_WORKFLOW_ID=
URBAN_SAFE_DIFY_WORKFLOW_VERSION=image-analysis-v1.0.1
URBAN_SAFE_DIFY_CONNECT_TIMEOUT_MS=300000
URBAN_SAFE_DIFY_READ_TIMEOUT_MS=300000

# 多应用隔离配置。旧版 URBAN_SAFE_DIFY_API_KEY 仅兼容映射到 image-analysis。
URBAN_SAFE_DIFY_IMAGE_ANALYSIS_API_KEY=
URBAN_SAFE_DIFY_IMAGE_ANALYSIS_APP_ID=
URBAN_SAFE_DIFY_IMAGE_ANALYSIS_VERSION=image-analysis-v1.1.0
URBAN_SAFE_DIFY_REVIEW_ASSIST_API_KEY=
URBAN_SAFE_DIFY_REVIEW_ASSIST_APP_ID=
URBAN_SAFE_DIFY_REVIEW_ASSIST_VERSION=review-assist-v1.0.0
URBAN_SAFE_DIFY_REPORT_DRAFT_API_KEY=
URBAN_SAFE_DIFY_REPORT_DRAFT_APP_ID=
URBAN_SAFE_DIFY_REPORT_DRAFT_VERSION=report-draft-v1.0.0
URBAN_SAFE_DIFY_KNOWLEDGE_QA_API_KEY=
URBAN_SAFE_DIFY_KNOWLEDGE_QA_APP_ID=
URBAN_SAFE_DIFY_KNOWLEDGE_QA_VERSION=knowledge-qa-v1.0.0

# ---------- Spring AI + DeepSeek 文本模型 ----------
# 默认关闭，因此未填写 DeepSeek API Key 时业务系统仍可正常启动，知识问答回退本地证据摘录。
# 填写 Key 后启用：URBAN_SAFE_SPRING_AI_PROVIDER_ENABLED=true，URBAN_SAFE_SPRING_AI_MODEL_CHAT=openai。
# 默认模型 deepseek-v4-flash；复杂报告/深度研判可显式改为 deepseek-v4-pro。
# 不再使用已停止的 deepseek-chat / deepseek-reasoner 模型名。
URBAN_SAFE_SPRING_AI_PROVIDER_ENABLED=false
URBAN_SAFE_SPRING_AI_PROVIDER_TYPE=DEEPSEEK
URBAN_SAFE_SPRING_AI_API_KEY=
URBAN_SAFE_SPRING_AI_BASE_URL=https://api.deepseek.com
URBAN_SAFE_SPRING_AI_MODEL=deepseek-v4-flash
URBAN_SAFE_SPRING_AI_MODEL_CHAT=none
URBAN_SAFE_SPRING_AI_CONNECT_TIMEOUT_MS=3000
URBAN_SAFE_SPRING_AI_READ_TIMEOUT_MS=30000

# ---------- CUDA-only 真实模型运行时 ----------
# 本地视觉模型由独立 FastAPI Runtime/Codex 配置；权重不得提交 Git。
# 自动上传视觉识别使用稳定业务 Model ID：AI-VISION-LOCAL-001。
# demo-rtx3060 profile 会把 MODEL_ROOT/CATALOG 指向 data/model-cache 下的演示目录。
URBAN_SAFE_AI_MODEL_ROOT=data/ai-service/models
URBAN_SAFE_AI_MODEL_CATALOG_PATH=runtime-catalog.json
URBAN_SAFE_AI_CUDA_DEVICE_ID=0

# ---------- 零样本本地视觉模型（Grounding DINO Tiny + SAM 2.1 Tiny）----------
# 比赛机 Profile B：CUDA REAL 推理；开发机 Profile A 不加载本模型（catalog 不含它）。
URBAN_SAFE_AI_VISUAL_DEVICE=cuda
URBAN_SAFE_AI_VISION_DTYPE=float16
URBAN_SAFE_AI_VISION_MAX_LONG_SIDE=1280
URBAN_SAFE_AI_VISION_BOX_THRESHOLD=0.25
URBAN_SAFE_AI_VISION_TEXT_THRESHOLD=0.25
URBAN_SAFE_AI_VISION_MAX_DETECTIONS=10
# 运行时只从本地缓存读权重（local_files_only），禁止联网下载。
URBAN_SAFE_AI_VISION_OFFLINE=true
URBAN_SAFE_AI_VISION_HF_HOME=data/model-cache/huggingface
# GPU 并发保护：同一进程同一 GPU 最多一个视觉推理；Uvicorn workers 必须为 1。
URBAN_SAFE_AI_VISUAL_MAX_CONCURRENCY=1
# SHA 门禁：STRICT（默认，启动时重算权重摘要与 manifest 对比）/ FAST。
URBAN_SAFE_AI_VISION_SHA_MODE=STRICT
