# 前端本地配置示例。
# 复制为 frontend/.env.local 后填写本机值；不得提交真实 Key 或安全密钥。

# API 模式：mock 启动 Mock Service Worker；real 调用真实 Spring Boot。
# 切换只发生在应用启动层与统一 API 层，页面不得编写 if(mockMode) 分支。
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:8888
VITE_MAP_CONFIG_ENDPOINT=/api/v1/map/runtime-config

# 公众反馈电话和短信入口。未配置时页面保留入口并提示尚未开通。
VITE_CITIZEN_HOTLINE=
VITE_CITIZEN_SMS_NUMBER=

# 推荐模式：由后端运行时配置返回 JS API Key，并通过 serviceHost 代理安全密钥。
VITE_MAP_PROVIDER=AMAP
VITE_MAP_SECURITY_MODE=SERVICE_HOST
VITE_MAP_SERVICE_HOST=/_AMapService
VITE_AMAP_JS_API_VERSION=2.0
VITE_MAP_DEFAULT_CENTER_LONGITUDE=113.13396
VITE_MAP_DEFAULT_CENTER_LATITUDE=27.82767
VITE_MAP_DEFAULT_ZOOM=12

# 本地开发备用模式：仅在运行时配置接口尚未完成时使用。
# 真实值只能写入 .env.local，不能写入本示例文件或提交 Git。
VITE_AMAP_JS_API_KEY=
VITE_AMAP_SECURITY_JS_CODE=

# 禁止在任何 VITE_* 变量中保存高德 Web 服务 Key、数据库密码或 MinIO 密钥。
# 正式比赛部署优先使用 SERVICE_HOST，不在浏览器构建产物中暴露 securityJsCode。
