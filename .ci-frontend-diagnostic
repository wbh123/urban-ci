           ? `；已有现场复检任务 ${created.taskCode}`%0A+           : `；已自动创建复检任务 ${created.taskCode}`%0A+         needsReinspection.value = false%0A+       } catch (error) {%0A+         appStore.notify(`人工复核已提交，但自动创建复检任务失败：${toAppError(error).message}`, 'warning')%0A+         await load()%0A+         return%0A+       }%0A+     }%0A+%0A+     appStore.notify(`人工复核结果已提交${reinspectionMessage}。`, 'success')%0A+     await load()%0A+   } catch (error) {%0A+     appStore.notify(toAppError(error).message, 'error')%0A+   } finally {%0A+     saving.value = false%0A+   }%0A+ }%0A+%0A+ async function createReinspectionFromReview(): Promise<void> {%0A+   const recordId = decisionRecordId.value%0A+   if (!recordId) {%0A+     appStore.notify('请先选择对应巡检记录。', 'warning')%0A+     return%0A+   }%0A+   reinspectionSaving.value = true%0A+   try {%0A+     const created = await api.createInspectionReinspection(recordId)%0A+     reviewWorkflow.value = await api.getInspectionReviewStatus(recordId)%0A+     appStore.notify(%0A+       created.reused ? `已有现场复检任务：${created.taskCode}` : `复检任务已创建：${created.taskCode}`,%0A+       'success',%0A+     )%0A+   } catch (error) {%0A+     appStore.notify(toAppError(error).message, 'error')%0A+   } finally {%0A+     reinspectionSaving.value = false%0A+   }%0A+ }%0A+%0A+ function openRiskMap(): void {%0A+   void router.push('/console/map')%0A+ }%0A+%0A+ function openReinspectionTask(): void {%0A+   const taskId = reviewWorkflow.value?.reinspectionTaskId%0A+   if (!taskId) return%0A+   void router.push({%0A+     name: 'console-inspections',%0A+     query: { taskId },%0A+   })%0A+ }%0A+%0A+ async function ensureAutoAgentAnalysis(next: AiInferenceTask): Promise<void> {%0A+   if (next.status !== 'SUCCEEDED' || next.mode !== 'REAL' || !next.buildingId) return%0A+   if (autoAnalysisRequestedForInferenceId.value === next.inferenceId) return%0A+   autoAnalysisRequestedForInferenceId.value = next.inferenceId%0A+   await runAgentAnalysis('AUTO')%0A+ }%0A+%0A+ async function runA