workflow?.reviewState === 'PENDING_REVIEW') return '待专业复核'%0A+   if (workflow?.reviewState === 'COMPLETED') return '复核已完成 · 可决定是否复检'%0A+   if (workflow?.reviewState === 'NO_AI_RESULT') return '暂无可复核 AI 结果'%0A+   return '可提交复核'%0A+ }%0A+%0A+ async function completeRecord(recordId: string): Promise<void> {%0A+   reviewActionRecordId.value = recordId%0A+   try {%0A+     const completed = await api.completeInspectionRecord(recordId)%0A+     detailRecords.value = detailRecords.value.map((record) => record.recordId === recordId ? completed : record)%0A+     const workflow = await api.getInspectionReviewStatus(recordId)%0A+     detailReviewStatuses.value = { ...detailReviewStatuses.value, [recordId]: workflow }%0A+     appStore.notify('巡检记录已标记为完成。', 'success')%0A+     await loadInspectionChain(recordId, false)%0A+   } catch (error) {%0A+     appStore.notify(toAppError(error).message, 'error')%0A+   } finally {%0A+     reviewActionRecordId.value = ''%0A+   }%0A+ }%0A+%0A+ async function submitReview(recordId: string): Promise<void> {%0A+   reviewActionRecordId.value = recordId%0A+   try {%0A+     const result = await api.submitInspectionReview(recordId)%0A+     detailReviewStatuses.value = { ...detailReviewStatuses.value, [recordId]: result }%0A+     appStore.notify(result.reused ? '该巡检记录已在人工复核队列中。' : '已提交人工复核，可在复核中心继续处理。', 'success')%0A+     await Promise.all([loadInspectionAiMetrics(), loadInspectionChain(recordId, false)])%0A+   } catch (error) {%0A+     appStore.notify(toAppError(error).message, 'error')%0A+   } finally {%0A+     reviewActionRecordId.value = ''%0A+   }%0A+ }%0A+%0A+ async function createReinspection(recordId: string): Promise<void> {%0A+   reviewActionRecordId.value = recordId%0A+   try {%0A+     const task = await api.createInspectionReinspection(recordId)%0A+     const [workflow, completedRecord] = await Promise.all([%0A+       api.getInspectionReviewStatus(recordId),%0A+       api.getInspectionRecord(recordId),%0A+     ])%0A+     detailReviewStatuses