DELETE {{baseUrl}}/api/v1/buildings/{{buildingId}}
Authorization: Bearer {{accessToken}}

> {%
  client.test("删除楼栋成功", function () {
    client.assert(response.status === 200);
    client.assert(response.body.success === true);
  });
%}

