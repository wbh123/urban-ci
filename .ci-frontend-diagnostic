alysis-stage__idle': !agentAnalysis }">%0A+           <div class="analysis-stage__identity">%0A+             <span class="analysis-stage__index">01</span>%0A+             <div>%0A+               <strong>AI 综合研判</strong>%0A+               <small>{{ agentAnalysis ? '跨楼栋档案、巡检证据、视觉结果与治理信息形成辅助研判' : agentAnalysisLoading ? '正在汇聚跨模块证据并形成研判…' : 'REAL 视觉识别完成后会自动生成，也可手动发起一次新研判' }}</small>%0A+             </div>%0A+           </div>%0A+           <div v-if="!agentAnalysis" class="analysis-stage__capabilities" aria-label="综合研判数据范围">%0A+             <span>楼栋档案</span><span>巡检证据</span><span>视觉识别</span><span>风险治理</span>%0A+           </div>%0A+           <div v-if="!agentAnalysis" class="analysis-stage__state">%0A+             <span class="analysis-stage__state-dot" :data-running="agentAnalysisLoading" />%0A+             <b>{{ agentAnalysisLoading ? '研判生成中' : agentAnalysisError ? '上次生成失败' : task.status === 'SUCCEEDED' ? '自动研判待生成' : '等待视觉结果' }}</b>%0A+           </div>%0A+           <el-button type="primary" :plain="Boolean(agentAnalysis)" round :loading="agentAnalysisLoading" :disabled="taskRunning" @click="runAgentAnalysis('MANUAL')">%0A+             {{ agentAnalysis ? '刷新综合研判' : agentAnalysisLoading ? '正在研判' : '生成综合研判' }}%0A+           </el-button>%0A+         </div>%0A+         <el-alert v-if="agentAnalysisError" class="analysis-stage__alert" :title="agentAnalysisError" type="warning" :closable="false" show-icon />%0A+         <div v-if="agentAnalysis" class="analysis-stage__body">%0A+           <AiStructuredAnalysisPanel%0A+             :result="agentAnalysis"%0A+             title="本楼栋综合研判"%0A+             subtitle="将视觉疑似病害与巡检、楼栋档案、正式风险和治理优先级放在同一视图中，便于专业人员集中复核。"%0A+           />%0A+         </div>%0A+       </section>%0A+%0A+       <div v-if="taskRunning" class="running-panel">%0A+         <el-icon class="is-loading"><Loading /></el-icon>%0A+         <div><strong>AI 视觉识别正在分析</strong><span>识别完成后将自动进入 AI 综合研判，基础巡检和人工操作不受影响。</span></div>%0A+         <el-tag type="warning" round>分析