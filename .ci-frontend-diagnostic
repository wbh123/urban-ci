tionAiCombinedSummary(taskId, inferenceId)%0A+   } catch (error) {%0A+     detailCombinedSummary.value = null%0A+     appStore.notify(`AI 巡检综合总结暂不可用：${toAppError(error).message}`, 'warning')%0A+   } finally {%0A+     detailCombinedSummaryLoading.value = false%0A+   }%0A+ }%0A+%0A+ function closeDetail(): void {%0A+   releaseDetailImageUrl()%0A+   detailInference.value = null%0A+   detailCombinedSummary.value = null%0A+   detailRecords.value = []%0A+   detailReviewStatuses.value = {}%0A+   detailChain.value = null%0A+   chainRecordId.value = ''%0A+   detailTask.value = null%0A+ }%0A+%0A+ function releaseDetailImageUrl(): void {%0A+   if (detailImageUrl.value) {%0A+     URL.revokeObjectURL(detailImageUrl.value)%0A+     detailImageUrl.value = ''%0A+   }%0A+ }%0A+%0A+ function inspectionTypeLabel(value?: string | null): string {%0A+   if (value === 'ROUTINE') return '日常巡检'%0A+   if (value === 'SPECIAL') return '专项巡检'%0A+   if (value === 'PUBLIC_FEEDBACK') return '群众反馈巡检'%0A+   if (value === 'REINSPECTION') return '复检任务'%0A+   return value || '—'%0A+ }%0A+%0A+ function taskSourceLabel(value?: string | null): string {%0A+   if (value === 'PUBLIC_FEEDBACK') return '群众反馈'%0A+   if (value === 'DAILY_INSPECTION') return '日常巡检'%0A+   if (value === 'SPECIAL_INSPECTION') return '专项巡检'%0A+   if (value === 'AI_ALERT') return 'AI 告警'%0A+   if (value === 'REINSPECTION') return '人工复检'%0A+   return '人工创建'%0A+ }%0A+%0A+ async function openTaskFromRoute(): Promise<void> {%0A+   const taskId = String(route.query.taskId ?? '')%0A+   if (!taskId) return%0A+   try {%0A+     const task = await api.getInspectionTask(taskId)%0A+     taskKeyword.value = task.taskCode%0A+     page.value = 1%0A+     await openDetail(task as InspectionTaskDisplay)%0A+   } catch (error) {%0A+     appStore.notify(`指定巡检任务加载失败：${toAppError(error).message}`, 'error')%0A+   }%0A+ }%0A+%0A+ onMounted(async () => {%0A+   await loadTasks()%0A+   await openTaskFromRoute()%0A+ })%0A+ </script>%0A+%0A+ <template>%0A+   <secti